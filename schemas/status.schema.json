{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:synology-nas-cli:schema:status",
  "title": "nas --json status",
  "type": "object",
  "required": [
    "model",
    "firmware_ver",
    "uptime",
    "sa_26_13",
    "sa_26_19",
    "dsm_patch",
    "latest_for_model"
  ],
  "$defs": {
    "verdict": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["patched", "vulnerable", "no_fix_for_branch", "unknown"]
        },
        "fixed_in": {"type": "string"},
        "note": {"type": "string"},
        "advisory": {"type": "string"},
        "url": {"type": "string"},
        "cves": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "properties": {
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "firmware_ver": {
      "type": "string"
    },
    "firmware_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "uptime": {
      "type": "string"
    },
    "nas_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "sys_temp_c": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "ram_mb": {
      "type": [
        "number",
        "string",
        "null"
      ]
    },
    "latest_for_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "sa_26_13": {"$ref": "#/$defs/verdict"},
    "sa_26_19": {"$ref": "#/$defs/verdict"},
    "dsm_patch": {"$ref": "#/$defs/verdict"}
  }
}
